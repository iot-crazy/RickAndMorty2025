@using RickAndMorty.DTO.Location;
@inherits LocationSelectorBase;

            <MudSelect T="LocationDto"
                       MultiSelection="false"
                       Variant="Variant.Outlined"
                       Value="@SelectedLocation"
                       ValueChanged="OnSelectedLocationChanged"
                       Placeholder="@Placeholder"
            Dense="false"
            Label="@Label">
                @foreach (var location in Locations)
                {
                    <MudSelectItem T="LocationDto" Value="location">@location.Name - @location.Dimension</MudSelectItem>
                }
            </MudSelect>


